{
  "name": "pawlytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:functions && npm run test:rules && npm run test:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:live": "node scripts/test-live-browser.mjs",
    "test:functions": "npm --prefix functions test",
    "test:live": "node scripts/live-smoke.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "grant:authority": "node scripts/grant-authority-access.mjs",
    "attach:sighting-images": "node scripts/attach-public-sighting-images.mjs",
    "backfill:timezones": "node scripts/backfill-sighting-timezones.mjs",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "deploy:functions": "firebase deploy --only functions",
    "typecheck": "tsc -b",
    "test:integration": "npm run build --prefix functions && node scripts/test-rules.mjs --integration"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.10",
    "exifr": "^7.1.3",
    "firebase": "^11.8.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-tools": "^15.28.1",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
