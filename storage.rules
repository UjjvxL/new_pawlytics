rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reportEvidence/{userId}/{reportId}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/reports/$(reportId))
        && firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }
    match /publicEvidence/{reportId}/{fileName} { allow read: if true; allow write: if false; }
    match /sightings/{allPaths=**} { allow read, write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
